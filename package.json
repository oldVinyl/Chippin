{"name":"chippin","private":true,"packageManager":"pnpm@10.26.0","scripts":{"dev":"pnpm db:up && pnpm db:deploy && pnpm seed && concurrently -n api,web -c yellow,cyan \"pnpm --filter @chippin/api dev\" \"pnpm --filter @chippin/web dev\"","build":"pnpm --filter @chippin/shared build && pnpm --filter @chippin/api build && pnpm --filter @chippin/web build","test":"pnpm --filter @chippin/api test","typecheck":"pnpm -r typecheck","db:up":"docker compose up -d --wait","db:generate":"pnpm --filter @chippin/api exec prisma generate","db:deploy":"pnpm --filter @chippin/api exec prisma migrate deploy","seed":"pnpm --filter @chippin/api seed","assets:check":"node scripts/assets-check.mjs","contrast:check":"node scripts/contrast-check.mjs","test:e2e":"pnpm exec playwright test","format":"prettier --write .","lint":"prettier --check ."},"devDependencies":{"concurrently":"^9.2.1","prettier":"^3.6.2","@playwright/test":"^1.56.0","tsx":"^4.20.6","typescript":"^5.9.3"}}
